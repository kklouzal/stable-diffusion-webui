# Build context allowlist. Only what the image build reads is sent, so the image never depends on untracked
# host state (config.json, params.txt, ui-config.json, styles.csv, cache/, config_states/, tmp/, outputs/,
# logs, caches) or ships non-runtime tracked content (test/, docs/, gb10/, README, changelog, ...).
# Patterns are relative to the context root. Add a new top-level runtime path here when the app gains one.
*
!webui.py
!launch.py
!modules
!scripts
!extensions-builtin
!configs
!html
!textual_inversion_templates
!requirements_versions.txt
!LICENSE.txt
# Build inputs copied by explicit COPY steps (the source stage drops them from the app tree).
!docker
!patches
# Never from inside the allowed trees either.
**/__pycache__
**/*.pyc
**/.DS_Store
